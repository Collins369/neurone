# Copy to `.env` and fill in. `.env` is gitignored.
#
# Solami Yellowstone gRPC credential. Sent as the `x-token` gRPC metadata
# header. REQUIRED when source = "solami".
SOLAMI_GRPC_TOKEN=

# --- Optional overrides -------------------------------------------------
# SOLAMI_GRPC_ENDPOINT=https://grpc.solami.dev:443
# SOLAMI_YELLOWSTONE_ENDPOINT=https://grpc.solami.dev:443   (alias)
# NEURONE_SOURCE=simulated
# NEURONE_SHARDS=8
# NEURONE_WORKER_THREADS=4
# NEURONE_CONFIG=config/default.toml
# RUST_LOG=neurone=info
